# ── Database (REQUIRED — no defaults; ADR-0012) ──────────────────
# These values are interpolated into compose with the `:?required` form.
# If any of POSTGRES_PASSWORD / DATABASE_URL is unset, containers refuse
# to start. Generate strong values with `openssl rand -base64 32`.
POSTGRES_USER=doc
POSTGRES_PASSWORD=                      # REQUIRED — set before `docker compose up`
POSTGRES_DB=doc
DATABASE_URL=                            # REQUIRED — e.g. postgresql+asyncpg://doc:<pw>@db:5432/doc

# Password used by the Postgres streaming-replication role.
# Required when running primary/standby compose files. ADR-0012: no default.
# For a standalone install you can leave this with any random throwaway value.
REPLICATION_PASSWORD=                    # REQUIRED — set before `docker compose up`

# Redis
REDIS_URL=redis://redis:6379/0

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
# MUST match the model `ollama-setup` pulls in docker-compose.yml (~4.9 GB).
# Point this at a model that was never pulled and report generation fails with
# a model-not-found error that surfaces in the UI as a generic "report failed".
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# LLM Provider: "ollama" (local, default) or "claude" (Anthropic cloud API)
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
# Anthropic model id used when LLM_PROVIDER=claude. Override to pin or bump.
CLAUDE_MODEL=claude-sonnet-4-6

# OpenDroneLog (optional — only needed for migration of existing data)
OPENDRONELOG_URL=http://your-opendronelog-host:8080

# DJI API Key (required for parsing encrypted DJI flight logs from newer drones)
# Register at https://developer.dji.com to obtain a key
DJI_API_KEY=

# JWT (REQUIRED — no default; ADR-0012)
# Generate with `openssl rand -hex 32`. Compose interpolates with `:?required`.
JWT_SECRET_KEY=                          # REQUIRED — set before `docker compose up`
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Operator Cloudflare Access SSO (ADR-0047) ─────────────────────────
# OPERATOR-ONLY — the customer client portal / intake / TOS-acceptance
# pages never read these and stay app-local permanently. Self-hosted /
# open-source installs and the public demo instance have no Cloudflare
# Access at all: leave every line in this section blank/false and nothing
# changes for you — local username/password login remains your only auth
# path, exactly as before this ADR shipped.
#
# BOTH of the next two must be set for verification to activate at all —
# leaving either blank keeps this entire feature dark (no network calls,
# no behavior change). Find these values in the Cloudflare Zero Trust
# dashboard for the Access application already fronting your hostname:
# Team domain -> Settings -> Custom Pages (or Access -> Applications ->
# your app -> Overview, "Application Audience (AUD) Tag").
CF_ACCESS_TEAM_DOMAIN=                   # e.g. yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                           # the Access application's AUD tag
# Comma-separated allow-list, defence in depth independent of Cloudflare's
# own Access policy. Defaults to bill@barnardhq.com (BarnardHQ's canonical
# operator identity) if left blank — self-hosters running their own
# instance MUST set this to their own email(s), or a verified BarnardHQ
# email would (harmlessly, since it's still gated behind YOUR Access app)
# be the only one accepted.
CF_ACCESS_ALLOWED_EMAILS=

# Step B kill switch. OFF (false) by default everywhere — do not set this
# until CF Access verification above has been proven live in production
# for a soak period. Setting it before verification is proven is how an
# operator locks themselves out of their own instance (no rollback within
# the same browser session — see docs/adr/0047-*.md). NEVER set this on a
# self-hosted/OSS install or the public demo instance; they have no other
# auth path.
LOCAL_LOGIN_DISABLED=false

# Service-account allow-list (ADR-0048). Comma-separated usernames that may
# keep using POST /api/auth/login and POST /api/auth/refresh even while
# LOCAL_LOGIN_DISABLED=true, because they are machine callers on a private
# network that cannot present a Cloudflare Access cookie. Blank by default:
# with it blank, LOCAL_LOGIN_DISABLED=true blocks every local login exactly
# as it did before this setting existed, so self-hosted/OSS installs and the
# public demo instance are unaffected.
#
# Case-SENSITIVE and matched byte-exact against the `users.username` column.
# Exempts these names from the "local login is retired" 403 and NOTHING else
# — the password check, the per-IP lockout and the is_active check all still
# apply, and POST /api/auth/setup and PUT /api/auth/account stay blocked for
# every name on this list. Keep it to non-interactive accounts: an entry here
# is an account whose password is still a live credential, so treat it as one.
SERVICE_ACCOUNT_USERNAMES=

# SMTP (configure in Settings page or here)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true

# App file storage
UPLOAD_DIR=/data/uploads
REPORTS_DIR=/data/reports

# Operator timezone (ADR-0017). Defines the CALENDAR DATE of a flight: the
# instant is stored in UTC, the date is the date in this zone. Evening Pacific
# flights otherwise roll to the next (UTC) day.
OPERATOR_TIMEZONE=America/Los_Angeles

# Lifetime of a customer intake link and of a client-portal access link.
INTAKE_TOKEN_EXPIRE_DAYS=7
CLIENT_TOKEN_EXPIRE_DAYS=30

# Frontend URL (used in intake email links — must be reachable by customers)
# For LAN-only: http://192.168.1.50:3080  |  For tunnel: https://yourdomain.com
FRONTEND_URL=http://localhost:3080

# Frontend port (set to 127.0.0.1:3080 to restrict to local-only when using tunnel)
# Use "3080" for LAN access, or "127.0.0.1:3080" for localhost-only
FRONTEND_PORT=3080

# ── Trusted-proxy IP resolution (Phase 7 hardening, ADR-0045; corrected
# 2026-09-21) ──────────────────────────────────────────────────────────
# Every rate limiter + the login lockout resolve the real client IP only
# from X-Forwarded-For sent by a TRUSTED reverse proxy — never trusted
# blindly. TRUSTED_PROXY_HOSTNAME is a COMMA-SEPARATED list of hostnames,
# each resolved via Docker's embedded DNS at call time; default
# "frontend,cloudflared" matches this compose file's real two-hop chain
# (cloudflared -> nginx -> uvicorn) — correct out of the box, no action
# needed. Set FORWARDED_ALLOW_IPS (comma-separated IPs/CIDRs) if you run
# behind a DIFFERENT or ADDITIONAL proxy layer (e.g. a second nginx/
# HAProxy in front of this stack, or a hop that can't be reached by
# hostname from this container's own Docker network — see
# docs/managed-hosting.md for the managed-tenant case, which needs
# TRUSTED_PROXY_HOSTNAME=caddy instead of this default entirely) — see
# backend/app/utils/client_ip.py.
TRUSTED_PROXY_HOSTNAME=frontend,cloudflared
FORWARDED_ALLOW_IPS=

# How long a signed-TOS download link (the customer's own copy) stays
# valid after acceptance. Default ~2 years — bounded but durable, not
# infinite. See backend/app/config.py.
TOS_SIGNED_DOWNLOAD_EXPIRE_DAYS=730

# ── Stripe (optional — enables client portal payments) ───────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google review prompt ─────────────────────────────────────────
# Surfaces on the final-invoice PDF, the report-delivery email, the
# post-payment success state in the client portal, the
# payment-received email, and the report-ready email. Unset = CTAs
# hide themselves. Use the g.page/r/<place>/review short link from
# the Google Business Profile.
GOOGLE_REVIEW_URL=https://g.page/r/Cbblmcdaz3GfEBM/review

# ── Base image updates ───────────────────────────────────────────
# There is NO Watchtower sidecar — removed 2026-06-05 (fleet ADR-0088); an
# auto-updater on a deployer-managed host is a second, uncoordinated deploy
# path. Base image tags are pinned in docker-compose.yml; bump them there.

# ── Cloudflare Tunnel (optional) ──────────────────────────────────
# Auto-starts with the app. Set the token to enable; leave blank to skip.
# Get your token from https://one.dash.cloudflare.com → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# ── Demo mode (optional — only used by docker-compose.demo.yml) ──
# Enables the demo guard middleware + demo banner. Leave false/blank for a
# normal install.
DEMO_MODE=false
# Auto-creates an admin account on boot. Leave blank for a normal install.
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
# READ BUT UNIMPLEMENTED — nothing in the app acts on this. The real reset is
# scripts/demo-nightly-reset.sh on a crontab (celery beat is not an option:
# the demo worker+beat must stay stopped, dunning-email hazard, ADR-0042).
DEMO_RESET_INTERVAL_HOURS=24

# ── Managed instance (BarnardHQ-hosted tier only) ────────────────
# A self-hosted install leaves all of these alone and creates its admin
# through the first-run setup wizard in the browser.
MANAGED_INSTANCE=false
CLIENT_ID=
# Auto-provisioned admin for MANAGED instances only — ignored otherwise.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Alerting: ntfy + the device-silence watchdog (optional) ──────
# Fleet ADR-0036 transport. Unset = the watchdogs still log to structured
# JSON, the alerts just don't go out (fail-soft, never raises).
NTFY_DRONEOPS_PUBLISHER_TOKEN=
# A device key used within ACTIVITY_WINDOW_DAYS but unseen for SILENCE_HOURS
# raises an alert; DEDUP_HOURS is the per-key cooldown on a long outage.
DEVICE_SILENCE_ACTIVITY_WINDOW_DAYS=7
DEVICE_SILENCE_HOURS=48
DEVICE_SILENCE_DEDUP_HOURS=12

# ── Observability (optional — central plane on HSH-HQ) ───────────
# Phase 5 of the BarnardHQ observability rollout. All three vars are
# DSN/endpoint gated — unset = no-op. Self-hosted single-tenant
# DroneOps installs can ignore this block.
#
# Backend (FastAPI + Celery) → Sentry/GlitchTip + OTLP/gRPC traces.
# Frontend (Vite) → Sentry/GlitchTip via VITE_SENTRY_DSN (build-time).
#
# Prod + demo defaults (post-2026-05-09 per noc-master ADR-0050;
# central Alloy co-located with InfraWatch on BOS-HQ):
#   SENTRY_DSN                     -> from ~/.secrets/observability-dsns.env
#   OTEL_EXPORTER_OTLP_ENDPOINT    -> http://alloy.barnardhq.com:4317 (BOS-HQ central Alloy)
#   ENV                            -> prod (or demo for the demo overlay)
#
# Demo overlay via docker-compose.demo.yml only changes ENV +
# SENTRY_ENVIRONMENT to `demo`; OTLP endpoint default is the same
# alloy.barnardhq.com hostname. Demo previously pinned CHAD-HQ
# 10.99.0.2:4317 pre-cutover.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=droneops-api
TENANT=shared
ENV=prod

# Frontend Sentry — build-time only (read by Vite at `npm run build`).
# Leave blank to skip — the frontend initFrontendSentry() bails out when
# VITE_SENTRY_DSN is empty.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# ── APP_VERSION — COSMETIC since v2.92.1, do not set it here ─────
# compose has `${APP_VERSION:-<current>}` defaults in five places, but NOTHING
# reads the env var any more: the Sentry/GlitchTip release tag comes from
# backend/app/version.py and from __APP_VERSION__ (vite-defined from
# frontend/package.json), and the Login/Setup footers always used the latter.
# A hand-set APP_VERSION line on BOS-HQ pinned 2.67.4 through ~25 minor
# releases and mis-tagged every error group — that is why this is spelled out
# rather than left as a blank line to fill in. ROADMAP H-1.

# ── BOS-HQ production override only (not for self-hosters) ───────────
# docker-compose.bos-prod.yml (the reviewed copy of BOS-HQ's auto-loaded
# docker-compose.override.yml) requires this in the HOST .env; the generic
# stack does not read it. Format: postgresql+asyncpg://droneops:<pw>@droneops-standby-db:5432/droneops
# BOS_PROMOTED_DATABASE_URL=
