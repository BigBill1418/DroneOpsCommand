+async def _require_worker_bearer(authorization: str) -> None:
+    """The Worker->origin credential check for the search route.
+
+    Mirrors `ingest.py`'s `_require_receiver_bearer` exactly (settings-store
+    token, `hmac.compare_digest`, 503 when unconfigured rather than a 401 —
+    so the operator's log points at the missing settings row, not a bearer
+    mismatch). Kept as its own small function rather than importing the
+    ingest one: receiver-write trust and worker-search-read trust are
+    different trust domains even though the mechanics are identical, and
+    ingest.py's own docstring is explicit that its helper is "the shared
+    receiver credential check for every route on THIS router" — extending
+    it to a different router's different caller would widen what a change
+    to the receiver check silently affects.
+    """
+    token = await store.get(_SEARCH_ORIGIN_TOKEN_KEY, "")
+    if not token:
+        archive_search_total.labels(result="unauthorized").inc()
+        raise HTTPException(status_code=503, detail="search_origin_auth_not_configured")
+    if not hmac.compare_digest(authorization or "", f"Bearer {token}"):
+        archive_search_total.labels(result="unauthorized").inc()
+        raise HTTPException(status_code=401, detail="unauthorized")
+
